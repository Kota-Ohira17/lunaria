{
  "name": "lunaria",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:phone": "nuxt dev --dotenv .env.phone",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "typecheck": "nuxt typecheck",
    "build:vercel": "drizzle-kit migrate && nuxt build",
    "db:migrate": "drizzle-kit migrate",
    "build:cloudflare": "nuxt build --preset cloudflare-module",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "db:migrate:d1": "wrangler d1 migrations apply lunaria --remote",
    "db:baseline:d1": "wrangler d1 execute lunaria --remote --file server/db/d1-baseline.sql"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "feather-icons": "^4.29.2",
    "nuxt": "~4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/feather-icons": "^4.29.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": "24.x"
  }
}
